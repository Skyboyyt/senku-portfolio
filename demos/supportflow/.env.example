# ---------------------------------------------------------------------------
# SupportFlow AI — environment variables
# Copy to .env for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Postgres connection. For Neon, use the pooled connection string with ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/supportflow
# Origin(s) of the web app, comma-separated. Used for CSRF checks, invite links and CORS.
WEB_ORIGIN=http://localhost:3000
# Public URL of this API (used in the widget install snippet).
API_PUBLIC_URL=http://localhost:4000
# Shared secret between the web app's /api proxy and the API (32+ chars). Required in production.
# Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=
# Reverse proxies in front of the API (Render: 1).
TRUST_PROXY_HOPS=1
SESSION_TTL_DAYS=30

# AI provider: anthropic | openai | extractive | none
# extractive answers from knowledge-base excerpts without a language model (no key needed).
# If unset, the API picks anthropic or openai when a key is present, otherwise extractive.
AI_PROVIDER=
# Model override. Defaults to claude-opus-5-5 for Anthropic. Required for OpenAI.
AI_MODEL=
AI_TIMEOUT_MS=25000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Billing: stripe | test | disabled
# test changes plans without payment (development only, refused in production).
BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Optional: POST new contact-form messages to a webhook (e.g. Slack incoming webhook).
CONTACT_WEBHOOK_URL=
# Public homepage demo workspace.
DEMO_ORG_SLUG=demo
DEMO_RETENTION_HOURS=24
JOBS_ENABLED=true

# --- Web (apps/web) ---------------------------------------------------------
# Server-side URL the web app's /api proxy forwards to.
API_INTERNAL_URL=http://localhost:4000
# Browser-visible API URL, used for WebSockets and the widget script.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public key of the demo workspace widget (printed by `pnpm demo:setup`).
NEXT_PUBLIC_DEMO_WIDGET_KEY=
# Canonical site URL for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
