# Local settings for `wrangler dev` (copy to .dev.vars, which is git-ignored).
PROXY_SHARED_SECRET=
WEB_ORIGIN=http://localhost:3000,http://localhost:8788
API_PUBLIC_URL=http://127.0.0.1:8787
COOKIE_SECURE=false
# Lets the e2e billing tests run locally; production refuses test billing.
NODE_ENV=development
BILLING_MODE=test
